#!/bin/bash
# ==============================================================================
# dArkOS-R36XX Enhanced Firstboot & Partition Expansion Engine
# Features: Comprehensive persistent logging to /boot/firstboot.log
# ==============================================================================

LOG_FILE="/boot/firstboot.log"

log() {
  local msg="[$(date +"%Y-%m-%d %H:%M:%S")] $1"
  echo "$msg" >> "$LOG_FILE"
}

log "================================================================"
log "  dArkOS-R36XX Firstboot Expansion Starting"
log "================================================================"

if mountpoint -q /roms; then
  log "Unmounting /roms..."
  sudo umount /roms >> "$LOG_FILE" 2>&1 || true
fi

sudo chmod 666 /dev/tty1
export TERM=linux
height="15"
width="55"

if [ -f "/boot/rk3326-rg351mp-linux.dtb" ] || [ -f "/boot/rk3326-g350-linux.dtb" ] || [ -f "/boot/rk3326-a10mini-linux.dtb" ]; then
  sudo setfont /usr/share/consolefonts/Lat7-Terminus20x10.psf.gz 2>/dev/null || true
  height="20"
  width="60"
fi

log "System Details:"
log "  Kernel: $(uname -a)"
log "  Disk Layout:"
lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS >> "$LOG_FILE" 2>&1

# Phase 1: MBR Partition Table Expansion & Reboot
if [ ! -f /boot/doneit ]; then
  log "Phase 1: Expanding MBR partition 3 boundary via sfdisk..."
  sudo echo ", +" | sudo sfdisk -N 3 --force /dev/mmcblk0 >> "$LOG_FILE" 2>&1
  sudo touch "/boot/doneit"
  log "Phase 1 complete. Rebooting in 3 seconds to reload partition table..."
  sync
  dialog --infobox "EASYROMS partition expansion in process. The device will now reboot to continue..." $height $width 2>&1 > /dev/tty1
  sleep 3
  sudo reboot
fi

log "Phase 2: Resizing filesystems and creating EASYROMS partition..."

(
  maxSize=$(lsblk -b --output SIZE -n -d /dev/mmcblk0)
  log "Max disk size: $maxSize bytes"

  newExtSizePct=$(printf %.2f "$((10**4 * 11000000000/$maxSize))e-4")
  newExtSizePct=$(echo print 1-$newExtSizePct | perl)
  ExfatPctToRemain=$(echo print 100*$newExtSizePct | perl)
  log "Calculated ExfatPctToRemain: $ExfatPctToRemain%"

  partition_type=$(df -T | grep mmcblk[0-1]p2 | cut -d " " -f 2)
  log "Root partition type: $partition_type"

  if [ $ExfatPctToRemain -lt "100" ]; then
    log "Deleting old partition 3 and growing partition 2..."
    printf "d\n3\nw\n" | sudo fdisk /dev/mmcblk0 >> "$LOG_FILE" 2>&1
    sudo growpart --free-percent=$ExfatPctToRemain -v /dev/mmcblk0 2 >> "$LOG_FILE" 2>&1
    
    if [[ "$partition_type" == *"ext"* ]]; then
      log "Resizing ext4 rootfs..."
      sudo resize2fs /dev/mmcblk0p2 >> "$LOG_FILE" 2>&1
    elif [[ "$partition_type" == *"xfs"* ]]; then
      sudo xfs_growfs /dev/mmcblk0p2 >> "$LOG_FILE" 2>&1
    elif [[ "$partition_type" == *"btrfs"* ]]; then
      sudo btrfs filesystem resize max / >> "$LOG_FILE" 2>&1
    fi
    
    ext4endSector=$(sudo sfdisk -l /dev/mmcblk0 | grep mmcblk0p2 | awk "{print \$3}")
    exfatstartSector=$(echo print 1+$ext4endSector | perl)
    log "Creating new Partition 3 starting at sector $exfatstartSector..."
    echo 30
    printf "n\np\n3\n$exfatstartSector\n\nt\n3\n11\nw\n" | sudo fdisk /dev/mmcblk0 >> "$LOG_FILE" 2>&1
    echo 45
  fi

  log "Formatting /dev/mmcblk0p3 as exFAT (Label: EASYROMS)..."
  sudo mkfs.exfat -c 16K -L EASYROMS /dev/mmcblk0p3 >> "$LOG_FILE" 2>&1
  sync
  echo 50
  sleep 2

  log "Verifying exFAT partition..."
  sudo fsck.exfat -a /dev/mmcblk0p3 >> "$LOG_FILE" 2>&1 || true
  sync
  echo 55

  printf "t\n3\n7\nw\n" | sudo fdisk /dev/mmcblk0 >> "$LOG_FILE" 2>&1
  echo 60

  log "Mounting /dev/mmcblk0p3 to /roms..."
  sudo mkdir -p /roms
  sudo mount -t exfat -w /dev/mmcblk0p3 /roms >> "$LOG_FILE" 2>&1
  exitcode=$?
  log "Mount exitcode: $exitcode"
  echo $exitcode > /tmp/code.txt
  sleep 2

  log "Extracting ROMs folder structure template..."
  (pv -n /roms.tar | tar --no-same-permissions --no-same-owner --warning=no-timestamp -xf - -C /) &> /tmp/tar_stat.txt &
  let COUNT=1
  while true; do
    VAL=$(tail -n 1 /tmp/tar_stat.txt 2>/dev/null || echo "0")
    if [[ "$VAL" == "100" ]]; then
      VAL_INT=$(awk "BEGIN {print ($VAL / 100) * 20 + 60}" 2> /dev/null | cut -d "." -f1)
      echo $VAL_INT
      break
    elif [[ "$VAL" != "$SAMEVAL" ]]; then
      VAL_INT=$(awk "BEGIN {print ($VAL / 100) * 20 + 60}" 2> /dev/null | cut -d "." -f1)
      echo $VAL_INT
      SAMEVAL="$VAL"
      continue
    elif [[ $COUNT -ge 15000 ]]; then
      log "WARNING: ROMs structure extraction timed out"
      break
    else
      let COUNT++
      continue
    fi
  done
  sync

  sudo mkdir -p /roms/videos

  log "Deploying themes to /roms/themes/..."
  sudo rm -rf /roms/themes/es-theme-nes-box/ &> /dev/null || true
  if [ -d "/tempthemes" ]; then
    cd /tempthemes
    (tar --no-same-permissions --no-same-owner --warning=no-timestamp -cf - . | pv -n -s $(du -sb /tempthemes/ | awk "{print \$1}") | tar --no-same-permissions --no-same-owner -xf - -C /roms/themes/) &> /tmp/tar_stat.txt &
    let COUNT=1
    while true; do
      VAL=$(tail -n 1 /tmp/tar_stat.txt 2>/dev/null || echo "0")
      if [[ "$VAL" -ge "100" ]]; then
        VAL_INT_CP=$(awk "BEGIN {print ($VAL / 100) * 15 + 80}" 2> /dev/null | cut -d "." -f1)
        echo $VAL_INT_CP
        break
      elif [[ "$VAL" != "$SAMEVAL" ]] && [[ ! -z "$VAL" ]]; then
        VAL_INT_CP=$(awk "BEGIN {print ($VAL / 100) * 15 + 80}" 2> /dev/null | cut -d "." -f1)
        echo $VAL_INT_CP
        SAMEVAL="$VAL"
        continue
      elif [[ $COUNT -ge 15000 ]]; then
        log "WARNING: Themes deployment timed out"
        break
      else
        let COUNT++
        continue
      fi
    done
    sync
    cd ..
    sudo rm -rf /tempthemes >> "$LOG_FILE" 2>&1 || true
  fi

  log "Updating /etc/fstab with exFAT configuration..."
  if [ -f "/boot/fstab.exfat" ]; then
    sudo cp -f /boot/fstab.exfat /etc/fstab >> "$LOG_FILE" 2>&1
    sudo rm -f /boot/fstab.exfat >> "$LOG_FILE" 2>&1
  fi

  sync
  sudo rm -f /boot/doneit* >> "$LOG_FILE" 2>&1 || true
  log "Phase 2 completed successfully!"
  echo 100
) | dialog --title "Firstboot setup of dArkOS" --gauge "Expanding rootfs and exfat partitions. Please wait..." $height $width 0 2>&1 > /dev/tty1

exitcode=$(cat /tmp/code.txt 2>/dev/null || echo "1")
if [ "$exitcode" == "0" ]; then
  log "Firstboot SUCCESS! System will reboot into dArkOS."
  dialog --infobox "Completed expansion of root filesystem and EASYROMS partition. The system will now reboot and load dArkOS." $height $width 2>&1 > /dev/tty1 | sleep 6
  systemctl disable firstboot.service >> "$LOG_FILE" 2>&1 || true
  sudo rm -f /boot/firstboot.sh >> "$LOG_FILE" 2>&1 || true
  sync
  reboot
else
  log "Firstboot FAILED with mount exitcode: $exitcode"
  echo "FIRSTBOOT FAILED: Mount exitcode $exitcode. Check /boot/firstboot.log for details." > /boot/FIRSTBOOT_ERROR.txt
  dialog --infobox "EASYROMS partition expansion reported an issue. Check /boot/firstboot.log on your SD card. Rebooting now..." $height $width 2>&1 > /dev/tty1 | sleep 8
  systemctl disable firstboot.service >> "$LOG_FILE" 2>&1 || true
  sudo rm -f /boot/firstboot.sh >> "$LOG_FILE" 2>&1 || true
  sync
  reboot
fi
